# Apache config for shared hosting (HostGator / cPanel).
# Every directive is wrapped in <IfModule> so a host without the module
# ignores it instead of returning 500.

# ── Compression ─────────────────────────────────────────────
# Images, video and PDFs are already compressed; gzipping them burns CPU for
# nothing. Only text-based assets benefit, and they shrink around 70%.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json image/svg+xml
</IfModule>

# ── Browser caching ─────────────────────────────────────────
# Published assets never change, so repeat visits should read them from disk
# instead of the network. HTML stays short-lived so edits show up quickly.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png        "access plus 1 year"
  ExpiresByType image/jpeg       "access plus 1 year"
  ExpiresByType image/gif        "access plus 1 year"
  ExpiresByType image/webp       "access plus 1 year"
  ExpiresByType image/svg+xml    "access plus 1 year"
  ExpiresByType text/css         "access plus 1 month"
  ExpiresByType text/javascript  "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/html        "access plus 10 minutes"
</IfModule>

# ── Source files ────────────────────────────────────────────
# Never serve a design source file. PDFs are deliberately NOT in this list:
# the resume is a PDF and is meant to be downloadable. Source decks are denied
# in assets/presentations/.htaccess instead, where they would actually land.
# Apache 2.4 and 2.2 spell this differently, so handle both.
<FilesMatch "\.(psd|ai|indd|sketch|fig)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# ── Misc ────────────────────────────────────────────────────
Options -Indexes
AddDefaultCharset UTF-8
